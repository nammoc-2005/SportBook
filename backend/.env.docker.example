# ─── Environment cho Docker (copy file này → đổi tên thành .env.docker) ───
# Sau đó chạy: docker compose --env-file .env.docker up -d

# Server
NODE_ENV=production
PORT=5000

# Database (Docker dùng tên service "mysql" thay vì localhost)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sportbook
DB_USER=sportbook
DB_PASSWORD=SportBook@2024!

# JWT — ĐỔI SECRET NÀY THÀNH GIÁ TRỊ NGẪU NHIÊN DÀI
JWT_SECRET=change_this_to_a_very_long_random_secret_string_in_production
JWT_EXPIRES_IN=30d

# OTP
OTP_DEMO_MODE=false
OTP_EXPIRY_MINUTES=5

# VietQR — Điền thông tin ngân hàng thật của bạn
BANK_ID=970436
BANK_ACCOUNT=your_actual_account_number
ACCOUNT_NAME=YOUR NAME IN CAPS NO ACCENTS

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
PUBLIC_BASE_URL=https://your-domain.com
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
